# PostgreSQL connection string. Copy this file to .env.local and fill in your own values.
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# DeepSeek API key used by /api/generate (the doubt-chat).
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Secret used to sign session cookies: at least 32 random characters (for example: openssl rand -hex 32).
# Changing it signs everyone out.
SESSION_SECRET=
# Optional: model for the doubt-chat (default: deepseek-flash). Chat runs with thinking disabled.
DEEPSEEK_CHAT_MODEL=deepseek-flash
# Optional, for the live thinking-trace provider: the model (default: deepseek-flash) and the max_tokens limit
# for one trace request (default: 8000). Reasoning tokens count inside max_tokens, so keep the limit generous.
DEEPSEEK_TRACE_MODEL=deepseek-flash
DEEPSEEK_TRACE_MAX_TOKENS=8000
# Optional: reasoning effort for the trace (low, high or max). Unset by default, which sends nothing and
# leaves DeepSeek's own default. Any other value is ignored.
# DEEPSEEK_TRACE_EFFORT=high
# Live trace, server side (POST /api/trace; used by the learner page only when NEXT_PUBLIC_LIVE_TRACE=true). All optional; the values shown are the defaults.
# TRACE_SOURCE=auto                 # auto, reasoning or steps
# TRACE_PROVIDER=deepseek           # deepseek or mock (mock needs no key and replays an invented sample)
# TRACE_MIN_WORDS=150               # auto: use the reasoning when its cleaned word count is within [min, max]
# TRACE_MAX_WORDS=500
# TRACE_REUSE=false                 # off by default and the study is unaffected. Only "true" turns it on: every learner then sees
#                                   # the newest saved ready trace of a question (no provider call, no new row, not counted in
#                                   # TRACE_MAX_PER_HOUR). With no saved trace, one is generated as usual.
# TRACE_MAX_PER_HOUR=20             # traces per user per rolling hour (counted in memory, per server process)
# TRACE_FIRST_EVENT_TIMEOUT_MS=30000
# TRACE_IDLE_TIMEOUT_MS=30000
# TRACE_TOTAL_TIMEOUT_MS=180000
# Live trace on the learner page. OFF by default: only the exact value "true" turns it on, and with it off the study
# is unaffected (stored question content, no extra request). It is fixed into the build, so changing it needs a
# rebuild and a restart. Keep it off for participants until the study team has approved it.
# NEXT_PUBLIC_LIVE_TRACE=true
