# PostgreSQL connection string. Copy this file to .env.local and fill in your own values.
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# DeepSeek API key used by /api/generate (the doubt-chat).
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Secret used to sign session cookies: at least 32 random characters (for example: openssl rand -hex 32).
# Changing it signs everyone out.
SESSION_SECRET=
# Optional: model for the doubt-chat (default: deepseek-flash). Chat runs with thinking disabled.
DEEPSEEK_CHAT_MODEL=deepseek-flash
# Optional, for the live thinking-trace provider: the model (default: deepseek-flash) and the max_tokens limit
# for one trace request (default: 8000). Reasoning tokens count inside max_tokens, so keep the limit generous.
DEEPSEEK_TRACE_MODEL=deepseek-flash
DEEPSEEK_TRACE_MAX_TOKENS=8000
# Optional: reasoning effort for the trace (low, high or max). Unset by default, which sends nothing and
# leaves DeepSeek's own default. Any other value is ignored.
# DEEPSEEK_TRACE_EFFORT=high
