# PostgreSQL connection string. Copy this file to .env.local and fill in your own values.
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# DeepSeek API key used by /api/generate (the doubt-chat).
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional: model for the doubt-chat (default: deepseek-flash). Chat runs with thinking disabled.
DEEPSEEK_CHAT_MODEL=deepseek-flash
